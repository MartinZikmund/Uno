<Page
	x:Class="SamplesApp.MainPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:primitives="using:Microsoft.Toolkit.Uwp.UI.Controls.Primitives"
    xmlns:toolkit="using:Microsoft.Toolkit.Uwp.UI.Controls"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	x:DefaultBindMode="OneWay"
	    xmlns:local="using:App1"
    mc:Ignorable="d">
    <Page.Resources>
        <Style TargetType="ContentControl">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style TargetType="local:TestControl">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:TestControl">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}">
                            <TextBox Text="{Binding Path=Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="Test1Template">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Test: " />
                <TextBox Text="{Binding Path=Test1, Mode=TwoWay}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Test2Template">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Test: " />
                <local:TestControl Text="{Binding Path=Test2, Mode=TwoWay}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>
    <Grid>
        <toolkit:DataGrid AutoGenerateColumns="False" ItemsSource="{x:Bind ViewModel.Items}">
            <toolkit:DataGrid.Columns>
                <toolkit:DataGridTextColumn
                    Width="120"
                    Binding="{Binding Path=Label}"
                    Header="Label"
                    IsReadOnly="True" />
                <toolkit:DataGridTemplateColumn Width="120" Header="Test1">
                    <toolkit:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=Test1}" />
                        </DataTemplate>
                    </toolkit:DataGridTemplateColumn.CellTemplate>
                    <toolkit:DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Test1Template}" />
                        </DataTemplate>
                    </toolkit:DataGridTemplateColumn.CellEditingTemplate>
                </toolkit:DataGridTemplateColumn>
                <toolkit:DataGridTemplateColumn Width="120" Header="Test2">
                    <toolkit:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=Test2}" />
                        </DataTemplate>
                    </toolkit:DataGridTemplateColumn.CellTemplate>
                    <toolkit:DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Test2Template}" />
                        </DataTemplate>
                    </toolkit:DataGridTemplateColumn.CellEditingTemplate>
                </toolkit:DataGridTemplateColumn>
            </toolkit:DataGrid.Columns>
        </toolkit:DataGrid>
    </Grid>
</Page>
